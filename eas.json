{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_NO_BUNDLE_SPLITTING": "1"
      }
    },
    "unsigned": {
      "distribution": "internal",
      "ios": {
        "withoutCredentials": true
      },
      "env": {
        "EXPO_NO_BUNDLE_SPLITTING": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "benlafreniere6@3913.com",
        "ascAppId": "PENDING",
        "appleTeamId": "PENDING"
      }
    }
  }
}